    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@supabase/supabase-js": "^2.49.1",
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.3",
    "@capacitor/cli": "6.2.3",
